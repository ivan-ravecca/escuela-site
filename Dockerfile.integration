FROM node:22-bookworm-slim AS build

WORKDIR /app

ARG VITE_API_URL=""
ARG VITE_SITE_URL="http://localhost:8080"
ARG VITE_GOOGLE_CLIENT_ID="integration-google-client"
ARG VITE_WORKSPACE_DOMAIN="example.com"
ARG VITE_TOKEN_STORAGE_KEY="auth_token"
ARG VITE_GOOGLE_ANALYTICS_ID=""
ARG VITE_ENABLE_AI="true"

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SITE_URL=${VITE_SITE_URL}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_WORKSPACE_DOMAIN=${VITE_WORKSPACE_DOMAIN}
ENV VITE_TOKEN_STORAGE_KEY=${VITE_TOKEN_STORAGE_KEY}
ENV VITE_GOOGLE_ANALYTICS_ID=${VITE_GOOGLE_ANALYTICS_ID}
ENV VITE_ENABLE_AI=${VITE_ENABLE_AI}

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY .htaccess ./.htaccess
COPY app.config.ts ./app.config.ts
COPY index.html ./index.html
COPY tsconfig*.json ./
COPY vite.config.ts ./vite.config.ts
COPY postcss.config.js ./postcss.config.js
COPY tailwind.config.js ./tailwind.config.js
COPY eslint.config.js ./eslint.config.js
COPY public ./public
COPY src ./src

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY docker/integration/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80